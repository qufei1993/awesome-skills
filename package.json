{
  "name": "awesome-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/catalog.mjs validate",
    "validate:publish": "node scripts/catalog.mjs validate --publish",
    "build": "node scripts/catalog.mjs build --resolve-upstream",
    "build:preview": "node scripts/catalog.mjs build --preview --resolve-upstream",
    "check": "npm test && npm run validate && npm run build:preview",
    "new:collection": "node scripts/catalog.mjs new",
    "sync:site": "node scripts/sync-site.mjs",
    "package:data": "node scripts/package-data.mjs",
    "deploy:data": "node scripts/deploy-data.mjs",
    "test:data": "node scripts/check-static-data.mjs",
    "dev:site": "node scripts/dev-site.mjs",
    "test:site": "node scripts/check-local-site.mjs"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "4.148.0"
  }
}
